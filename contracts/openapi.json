{
  "openapi": "3.1.0",
  "info": {
    "title": "demo-site HTTP API",
    "version": "0.1.0",
    "description": "Foundation phase. Business O/S command APIs are not yet migrated. AWCP protocol remains in the browser."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Process and SQLite available"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "description": "Create or resume an isolated demo session; sets HttpOnly SameSite=Lax cookie. No raw token in JSON.",
        "responses": {
          "200": {
            "description": "Session metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/reset": {
      "post": {
        "operationId": "resetSession",
        "security": [
          {
            "demoCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-Demo-Generation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Browser-managed header; must match configured origins."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Generation/reset conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/query": {
      "post": {
        "operationId": "queryHistoricalReport",
        "security": [
          {
            "demoCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-Demo-Generation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Browser-managed header; must match configured origins."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportFilter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Generation/reset conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "operationId": "observeWorkspace",
        "security": [
          {
            "demoCookie": []
          }
        ],
        "description": "Cookie-authorized SSE for the current workspace. ready/heartbeat have no cursor; change contains WorkspaceEvent and an id. Last-Event-ID overrides after. Replays up to 128 events per poll; expired/foreign cursors produce sync.required. session.invalid closes the connection. No tokens in URLs.",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "UTF-8 event stream; change data is WorkspaceEvent JSON.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired browser session"
          },
          "403": {
            "description": "Cross-origin request denied"
          }
        }
      }
    },
    "/api/v1/settings/awcp": {
      "get": {
        "operationId": "getAwcpSettings",
        "description": "Read the site-wide active browser exposure setting. Default is disabled.",
        "responses": {
          "200": {
            "description": "Current site setting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AwcpSettings"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "updateAwcpSettings",
        "description": "Change active exposure for all visitors with a valid demo session, current generation, trusted Origin and expected settings version. Independent from workspace resets and MCP.",
        "security": [
          {
            "demoCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-Demo-Generation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AwcpSettingsInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved setting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AwcpSettings"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Untrusted origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale generation or settings version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "demoCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "awcp_demo"
      }
    },
    "schemas": {
      "Employee": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "departmentId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "departmentId",
          "name",
          "roles",
          "active"
        ]
      },
      "Department": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "generation": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "datasetVersion": {
            "type": "string"
          },
          "profile": {
            "type": "string",
            "enum": [
              "acceptance",
              "standard"
            ]
          },
          "simulatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "employees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Employee"
            }
          },
          "departments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Department"
            }
          },
          "recordCount": {
            "type": "integer"
          },
          "mcpAvailable": {
            "type": "boolean"
          },
          "mcpConnectUrl": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "description": "Committed workspace event revision captured in the same transaction as this snapshot."
          },
          "eventCursor": {
            "type": "string",
            "description": "Workspace-bound SSE resume cursor for this snapshot."
          },
          "operationId": {
            "type": "string",
            "description": "Mutation receipt identifier; present on reset responses."
          }
        },
        "required": [
          "id",
          "generation",
          "seed",
          "datasetVersion",
          "profile",
          "simulatedAt",
          "expiresAt",
          "employees",
          "departments",
          "recordCount",
          "revision",
          "eventCursor"
        ]
      },
      "ResetInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "ReportFilter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
          },
          "to": {
            "type": "string",
            "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
          },
          "departmentId": {
            "type": "string",
            "pattern": "^(|DEP-[0-9]{3})$"
          },
          "scenarioId": {
            "type": "string",
            "enum": [
              "",
              "O08",
              "O09",
              "O11",
              "O12",
              "O15"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "",
              "pending",
              "approved",
              "returned",
              "withdrawn"
            ]
          },
          "groupBy": {
            "type": "string",
            "enum": [
              "month",
              "department",
              "scenario",
              "status"
            ],
            "default": "month"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "required": []
      },
      "Metrics": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "amountCents": {
            "type": "integer",
            "minimum": 0
          },
          "approved": {
            "type": "integer",
            "minimum": 0
          },
          "overdue": {
            "type": "integer",
            "minimum": 0
          },
          "averageHours": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "count",
          "amountCents",
          "approved",
          "overdue",
          "averageHours"
        ]
      },
      "ReportGroup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "amountCents": {
            "type": "integer",
            "minimum": 0
          },
          "approved": {
            "type": "integer",
            "minimum": 0
          },
          "overdue": {
            "type": "integer",
            "minimum": 0
          },
          "averageHours": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "count",
          "amountCents",
          "approved",
          "overdue",
          "averageHours"
        ]
      },
      "ReportEntry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "scenarioId": {
            "type": "string"
          },
          "departmentId": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "amountCents": {
            "type": "integer"
          },
          "createdOn": {
            "type": "string",
            "format": "date"
          },
          "durationHours": {
            "type": [
              "integer",
              "null"
            ]
          },
          "overdue": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "scenarioId",
          "departmentId",
          "ownerId",
          "title",
          "status",
          "amountCents",
          "createdOn",
          "durationHours",
          "overdue"
        ]
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "generation": {
            "type": "string"
          },
          "filter": {
            "$ref": "#/components/schemas/ReportFilter"
          },
          "summary": {
            "$ref": "#/components/schemas/Metrics"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportGroup"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportEntry"
            }
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "description": "Committed workspace event revision captured in the same transaction as this snapshot."
          }
        },
        "required": [
          "generation",
          "filter",
          "summary",
          "groups",
          "items",
          "revision"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "messages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "path",
                "messages"
              ]
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "WorkspaceEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspaceId",
          "generation",
          "revision",
          "type",
          "source",
          "resources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "generation": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "operationId": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AwcpSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activeEnabled",
          "version"
        ],
        "properties": {
          "activeEnabled": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AwcpSettingsInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activeEnabled",
          "expectedVersion"
        ],
        "properties": {
          "activeEnabled": {
            "type": "boolean"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
